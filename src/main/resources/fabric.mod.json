{
    "schemaVersion": 1,
    "id": "interactive_enchanted_books",
    "version": "${version}",
    "name": "Interactive Enchanted Books",
    "description": "Allows opening of enchanted books to view enchantment details",
    "authors": [
        "Bristn"
    ],
    "contact": {
        "homepage": "",
        "sources": "https://github.com/Bristn/minecraft-interactive-enchanted-books"
    },
    "license": "CC0-1.0",
    "icon": "assets/interactive_enchanted_books/icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            "net.bristn.interactive_enchanted_books.LecternEnchantedBooksClient"
        ],
        "main": [
            "net.bristn.interactive_enchanted_books.LecternEnchantedBooks"
        ],
        "fabric-datagen": [
            "net.bristn.interactive_enchanted_books.LecternEnchantedBooksDataGenerator"
        ]
    },
    "mixins": [
        "interactive_enchanted_books.mixins.json",
        {
            "config": "interactive_enchanted_books.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~26.1-",
        "java": ">=25",
        "fabric-api": "*"
    }
}